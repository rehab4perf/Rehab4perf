.DS_Store
.claude/*
# Les skills du projet sont un actif du depot, pas une preference locale : non
# versionnees, elles disparaissent au premier changement de machine et le
# rituel de deploiement repart de zero.
!.claude/skills/
# Les reglages locaux, eux, restent locaux (chemins et permissions machine).
.claude/settings.local.json
supabase/.temp/

# Banque de SVG achetee (non utilisee telle quelle par l'app)
mycollection/

# Travaux marketing (carrousels Instagram, maquettes de communication).
# Netlify publie la RACINE du repo : tout fichier commite ici serait servi
# publiquement sur rehab4perf.netlify.app. Ces fichiers restent donc locaux.
marketing/

# Jeu de test golden-master (donnees patients reelles - ne jamais commiter)
tests-golden/
